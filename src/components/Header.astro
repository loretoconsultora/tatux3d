---
// Links absolutos ("/#...") para que funcionen también desde /maquinas.
const links = [
  { href: "/#casos", label: "Casos de éxito" },
  { href: "/#granjas", label: "Pequeñas granjas" },
  { href: "/#maquinas", label: "Venta de impresoras" },
  { href: "/#contacto", label: "Contacto" },
];
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/images/tatux-logo.png" alt="TATUX 3D" />
      <span class="header__tagline">Granja de Impresión 3D</span>
    </a>
    <nav class="header__nav" aria-label="Principal">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header__actions">
      <button type="button" class="btn btn-solid header__cta" data-open-modal="booking">
        <span class="header__cta-short">Cotización</span>
        <span class="header__cta-full">Solicitar cotización</span>
      </button>
      <button type="button" class="header__menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="header__mobile-nav" aria-label="Menú" hidden>
    <div class="container">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".header__menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  if (toggle && mobileNav) {
    const setOpen = (open: boolean) => {
      mobileNav.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };
    toggle.addEventListener("click", () => setOpen(mobileNav.hidden));
    mobileNav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 14px;
  }

  .header__logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .header__logo img {
    height: 26px;
    width: auto;
    display: block;
  }

  /* Tagline bajo el logo, en el mismo azul de la marca. */
  .header__tagline {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--color-blue-electric);
    white-space: nowrap;
  }

  .header__nav {
    display: none;
    gap: 28px;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .header__menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 0 10px;
    border-radius: 50%;
    border: none;
    background: rgba(3, 42, 242, 0.08);
    cursor: pointer;
  }

  .header__menu-toggle span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--color-blue-deep);
  }

  .header__mobile-nav {
    border-top: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.96);
  }

  .header__mobile-nav .container {
    display: flex;
    flex-direction: column;
    padding-block: 8px;
  }

  .header__mobile-nav a {
    padding: 12px 0;
    text-decoration: none;
    font-weight: 700;
    color: var(--color-blue-deep);
    border-bottom: 1px solid var(--color-border);
  }

  .header__mobile-nav a:last-child {
    border-bottom: none;
  }

  .header__nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .header__nav a:hover {
    color: var(--color-blue-electric);
  }

  .header__cta {
    padding: 10px 18px;
    font-size: 0.85rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .header__cta-full {
    display: none;
  }

  @media (min-width: 480px) {
    .header__logo img {
      height: 32px;
    }

    .header__cta {
      padding: 10px 22px;
      font-size: 0.9rem;
    }

    .header__cta-short {
      display: none;
    }

    .header__cta-full {
      display: inline;
    }
  }

  @media (min-width: 640px) {
    .header__tagline {
      font-size: 0.7rem;
    }
  }

  @media (min-width: 960px) {
    .header__nav {
      display: flex;
    }

    .header__menu-toggle,
    .header__mobile-nav {
      display: none !important;
    }
  }

</style>
