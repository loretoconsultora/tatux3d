---
import { siteConfig } from "../data/site";

const { machines, contact } = siteConfig;
const whatsappHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(machines.whatsappMessage)}`;
---

<div class="machine-cards">
  {
    machines.models.map((model) => (
      <article class="card-soft machine-card">
        <div class="machine-card__photo">
          {model.image ? (
            <img src={model.image} alt={model.name} loading="lazy" />
          ) : (
            <div class="machine-card__placeholder">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <circle cx="9" cy="10" r="2" />
                <path d="M21 16l-5-5-9 9" />
              </svg>
              <span>Foto del modelo</span>
            </div>
          )}
        </div>
        <div class="machine-card__body">
          <h3 class="machine-card__name">{model.name}</h3>
          <p class="machine-card__description">{model.description}</p>
          <p class="machine-card__price">{model.price}</p>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="machine-card__cta">
            <svg viewBox="0 0 32 32" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.23.62 4.38 1.78 6.26L3 29l7.9-2.7a12.9 12.9 0 0 0 5.12 1.05h.01c6.62 0 12.02-5.4 12.02-12.02C28.05 8.4 22.65 3 16.02 3zm0 21.9h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-4.7 1.6 1.58-4.58-.24-.38a9.86 9.86 0 0 1-1.51-5.25c0-5.46 4.45-9.91 9.9-9.91 2.65 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.9 7c0 5.46-4.45 9.91-9.6 9.91zm5.43-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.5-.17 0-.37-.02-.57-.02s-.52.07-.8.37c-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z" />
            </svg>
            Quiero esta impresora
          </a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .machine-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 700px) {
    .machine-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .machine-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .machine-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .machine-card__photo {
    aspect-ratio: 4 / 3;
    background: var(--color-bg-soft);
  }

  .machine-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .machine-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(3, 42, 242, 0.45);
    font-size: 0.85rem;
    font-weight: 700;
    border-bottom: 2px dashed rgba(3, 42, 242, 0.18);
  }

  .machine-card__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .machine-card__name {
    font-size: 1.15rem;
    color: var(--color-blue-deep);
  }

  .machine-card__description {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .machine-card__price {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-blue-electric);
  }

  .machine-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 18px;
    border-radius: var(--radius-full);
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .machine-card__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(37, 211, 102, 0.4);
  }
</style>
