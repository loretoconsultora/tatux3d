---
import { siteConfig, type LeadOrigin } from "../data/site";

interface Props {
  formId: string;
  heading?: string;
  /** Sección desde donde se envía el lead (se guarda en el CRM). */
  origin?: LeadOrigin;
  /** Qué pasa después de enviar: abrir Calendly o mostrar un mensaje. */
  afterSubmit?: "calendly" | "message";
  submitLabel?: string;
  footnote?: string;
}

const {
  formId,
  heading = "Da el primer paso hoy",
  origin = "Contacto",
  afterSubmit = "calendly",
  submitLabel = "Agendar Llamada de Cotización",
  footnote = "Te contactamos en menos de 24 horas.",
} = Astro.props;
const errorId = `${formId}-error`;
const successId = `${formId}-success`;
const calendlyId = `${formId}-calendly`;
---

<div class="booking-card glass">
  <h3 class="booking-card__title">{heading}</h3>

  <form id={formId} class="booking-card__form" novalidate>
    <input type="hidden" name="origin" value={origin} data-lead-origin-input />

    <!-- Honeypot anti-spam: invisible para personas, los bots lo completan. -->
    <div class="booking-card__hp" aria-hidden="true">
      <label for={`${formId}-website`}>No completar</label>
      <input id={`${formId}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="booking-card__field">
      <label for={`${formId}-name`}>Nombre completo</label>
      <input id={`${formId}-name`} name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Tu nombre" />
    </div>
    <div class="booking-card__row">
      <div class="booking-card__field">
        <label for={`${formId}-email`}>Email</label>
        <input id={`${formId}-email`} name="email" type="email" required maxlength="200" autocomplete="email" placeholder="tu@email.com" />
      </div>
      <div class="booking-card__field">
        <label for={`${formId}-phone`}>WhatsApp</label>
        <input id={`${formId}-phone`} name="phone" type="tel" required maxlength="40" autocomplete="tel" placeholder="+54 9 ..." />
      </div>
    </div>
    <div class="booking-card__field">
      <label for={`${formId}-company`}>Empresa <span class="booking-card__optional">(opcional)</span></label>
      <input id={`${formId}-company`} name="company" type="text" maxlength="200" autocomplete="organization" placeholder="Nombre de tu empresa" />
    </div>
    <div class="booking-card__field">
      <label for={`${formId}-project`}>¿Qué necesitás producir?</label>
      <select id={`${formId}-project`} name="project" required>
        <option value="" selected disabled>Seleccioná una opción</option>
        {siteConfig.projectOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </div>
    <div class="booking-card__row">
      <div class="booking-card__field">
        <label for={`${formId}-quantity`}>Cantidad de piezas</label>
        <input id={`${formId}-quantity`} name="quantity" type="number" inputmode="numeric" min="1" step="1" required placeholder="Ej: 50" />
      </div>
      <div class="booking-card__field">
        <label for={`${formId}-urgency`}>¿Para cuándo lo necesitás?</label>
        <select id={`${formId}-urgency`} name="urgency" required>
          <option value="" selected disabled>Seleccioná</option>
          {siteConfig.urgencyOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </div>
    </div>
    <div class="booking-card__field">
      <label for={`${formId}-message`}>Mensaje <span class="booking-card__optional">(opcional)</span></label>
      <textarea id={`${formId}-message`} name="message" rows="3" maxlength="3000" placeholder="Contanos brevemente tu proyecto"></textarea>
    </div>

    <button type="submit" class="btn btn-solid booking-card__submit">
      <span class="booking-card__submit-label">{submitLabel}</span>
    </button>
  </form>

  <div id={calendlyId} class="booking-card__calendly-inline" hidden></div>

  <div id={successId} class="booking-card__success" hidden>
    <p class="booking-card__success-title">¡Gracias! Recibimos tu consulta.</p>
    <p>Te contactamos en menos de 24 horas. Si es urgente, escribinos por <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>.</p>
  </div>

  <p id={errorId} class="booking-card__error" role="alert" hidden></p>

  <p class="booking-card__footnote">{footnote}</p>
</div>

<script
  define:vars={{
    formId,
    errorId,
    successId,
    calendlyId,
    afterSubmit,
    submitLabelText: submitLabel,
    calendlyUrl: siteConfig.calendlyUrl,
    leadEndpoint: siteConfig.leadEndpoint,
    whatsappUrl: siteConfig.contact.whatsapp,
  }}
>
  const form = document.getElementById(formId);
  const submitButton = form?.querySelector("button[type=submit]");
  const submitLabel = form?.querySelector(".booking-card__submit-label");
  const calendlyContainer = document.getElementById(calendlyId);
  const successMessage = document.getElementById(successId);
  const errorMessage = document.getElementById(errorId);
  const card = form?.closest(".booking-card");

  function showError(html) {
    errorMessage.innerHTML = html;
    errorMessage.hidden = false;
  }

  function loadCalendlyAssets(onReady) {
    if (window.Calendly) {
      onReady();
      return;
    }

    if (!document.querySelector('link[data-calendly-widget]')) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://assets.calendly.com/assets/external/widget.css";
      link.dataset.calendlyWidget = "true";
      document.head.appendChild(link);
    }

    const existingScript = document.querySelector('script[data-calendly-widget]');
    if (existingScript) {
      existingScript.addEventListener("load", onReady, { once: true });
      return;
    }

    const script = document.createElement("script");
    script.src = "https://assets.calendly.com/assets/external/widget.js";
    script.async = true;
    script.dataset.calendlyWidget = "true";
    script.addEventListener("load", onReady, { once: true });
    document.head.appendChild(script);
  }

  // Pre-cargamos Calendly para que esté listo al terminar el formulario.
  if (afterSubmit === "calendly") loadCalendlyAssets(() => {});

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const value = (key) => String(data.get(key) || "").trim();
    const payload = {
      name: value("name"),
      email: value("email"),
      phone: value("phone"),
      company: value("company"),
      project: value("project"),
      quantity: value("quantity"),
      urgency: value("urgency"),
      message: value("message"),
      origin: value("origin"),
      website: value("website"),
      page: window.location.href,
    };

    const quantity = Number(payload.quantity);
    if (!payload.name || !payload.email || !payload.phone || !payload.project || !payload.urgency) {
      showError("Completá todos los campos obligatorios para continuar.");
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) {
      showError("Revisá el email: parece que no es válido.");
      return;
    }
    if (!Number.isInteger(quantity) || quantity < 1) {
      showError("La cantidad de piezas tiene que ser un número entero, mínimo 1.");
      return;
    }

    errorMessage.hidden = true;
    submitButton.disabled = true;
    submitLabel.textContent = "Enviando...";

    let result = null;
    try {
      const response = await fetch(leadEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      result = await response.json().catch(() => null);
      if (!response.ok || !result?.ok) throw new Error(result?.message || `HTTP ${response.status}`);
    } catch (err) {
      console.error("No se pudo enviar el formulario:", err);
      submitButton.disabled = false;
      submitLabel.textContent = submitLabelText;
      const serverMessage = result?.message ? `${result.message} ` : "No pudimos enviar tu consulta. ";
      showError(
        `${serverMessage}Probá de nuevo en unos minutos o escribinos por <a href="${whatsappUrl}" target="_blank" rel="noopener noreferrer">WhatsApp</a>.`,
      );
      return;
    }

    form.hidden = true;

    if (afterSubmit === "message") {
      successMessage.hidden = false;
      card?.classList.add("booking-card--done");
      return;
    }

    calendlyContainer.hidden = false;
    card?.classList.add("booking-card--calendly-active");

    loadCalendlyAssets(() => {
      window.Calendly.initInlineWidget({
        url: calendlyUrl,
        parentElement: calendlyContainer,
        prefill: { name: payload.name, email: payload.email },
      });
    });
  });
</script>

<style>
  .booking-card {
    color: var(--color-text);
    border-radius: var(--radius-xl);
    padding: 28px;
    text-align: left;
    box-shadow: var(--shadow-lg);
    min-width: 0;
  }

  .booking-card--calendly-active {
    padding: 16px;
  }

  .booking-card__title {
    font-size: 1.4rem;
    margin-top: 0;
    margin-bottom: 16px;
    color: var(--color-blue-deep);
  }

  .booking-card--calendly-active .booking-card__title {
    display: none;
  }

  .booking-card__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .booking-card__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  @media (min-width: 520px) {
    .booking-card__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .booking-card__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .booking-card__field label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-blue-deep);
  }

  .booking-card__optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .booking-card__field input,
  .booking-card__field select,
  .booking-card__field textarea {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid rgba(3, 42, 242, 0.14);
    font-size: 1rem;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .booking-card__field textarea {
    resize: vertical;
    min-height: 84px;
  }

  .booking-card__field input:focus,
  .booking-card__field select:focus,
  .booking-card__field textarea:focus {
    outline: none;
    border-color: var(--color-blue-electric);
    box-shadow: 0 0 0 4px rgba(3, 42, 242, 0.12);
  }

  .booking-card__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .booking-card__submit {
    margin-top: 4px;
    width: 100%;
  }

  .booking-card__calendly-inline {
    width: 100%;
    min-height: 720px;
    height: 80vh;
    margin-top: 4px;
  }

  .booking-card__success {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-text);
  }

  .booking-card__success-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-blue-electric);
  }

  .booking-card__error {
    color: #d1350f;
    font-weight: 700;
    font-size: 0.85rem;
    margin-top: 8px;
  }

  .booking-card__error :global(a),
  .booking-card__success a {
    color: var(--color-blue-electric);
  }

  .booking-card__footnote {
    margin-top: 14px;
    font-size: 0.8rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .booking-card--calendly-active .booking-card__footnote,
  .booking-card--done .booking-card__footnote {
    display: none;
  }
</style>
