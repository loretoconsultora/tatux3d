---
import { siteConfig } from "../data/site";
import MachineCards from "./MachineCards.astro";

const { machines } = siteConfig;
---

<section id="maquinas" class="section machines-home aura-mint">
  <div class="container">
    <div class="machines-home__header">
      <p class="eyebrow machines-home__eyebrow">Venta de impresoras</p>
      <h2 class="machines-home__title">{machines.teaserTitle}</h2>
      <p class="machines-home__text">{machines.teaserText}</p>
    </div>

    <MachineCards />

    <p class="machines-home__more">
      <a href="/maquinas">Ver capacitación y soporte →</a>
    </p>
  </div>
</section>

<style>
  .machines-home__header {
    max-width: 720px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .machines-home__eyebrow {
    color: var(--color-blue-electric);
    margin-bottom: 8px;
  }

  .machines-home__title {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: var(--color-blue-deep);
  }

  .machines-home__text {
    color: var(--color-text-muted);
    margin-top: 12px;
  }

  .machines-home__more {
    text-align: center;
    margin-top: 32px;
  }

  .machines-home__more a {
    color: var(--color-blue-electric);
    font-weight: 700;
    text-decoration: none;
  }
</style>
