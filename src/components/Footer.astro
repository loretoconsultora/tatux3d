---
import { siteConfig } from "../data/site";

const { contact } = siteConfig;
---

<footer id="contacto" class="footer aura-blue">
  <div class="container footer__inner">
    <p class="eyebrow footer__eyebrow">Respuesta en menos de 24 horas</p>
    <h2 class="footer__title">Agendá tu {siteConfig.appointmentName}</h2>
    <p class="footer__subtitle">Escribinos y te ayudamos a encontrar la mejor forma de producir.</p>
    <div class="footer__ctas">
      <button type="button" class="btn btn-solid" data-open-modal="booking" data-lead-origin="Contacto">Quiero mi Asesoría</button>
      <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Escribinos por WhatsApp</a>
    </div>

    <ul class="footer__contact">
      <li>
        <span class="footer__contact-label">Dirección</span>
        <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{contact.address}</a>
      </li>
      <li>
        <span class="footer__contact-label">Teléfono</span>
        <a href={contact.phoneHref}>{contact.phone}</a>
      </li>
      <li>
        <span class="footer__contact-label">WhatsApp</span>
        <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer">{contact.phone}</a>
      </li>
      <li>
        <span class="footer__contact-label">Instagram</span>
        <a href={contact.instagram} target="_blank" rel="noopener noreferrer">{contact.instagramHandle}</a>
      </li>
      <li>
        <span class="footer__contact-label">Facebook</span>
        <a href={contact.facebook} target="_blank" rel="noopener noreferrer">{contact.facebookHandle}</a>
      </li>
    </ul>

    <div class="footer__social">
      <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
        <svg viewBox="0 0 32 32" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.23.62 4.38 1.78 6.26L3 29l7.9-2.7a12.9 12.9 0 0 0 5.12 1.05h.01c6.62 0 12.02-5.4 12.02-12.02C28.05 8.4 22.65 3 16.02 3zm0 21.9h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-4.7 1.6 1.58-4.58-.24-.38a9.86 9.86 0 0 1-1.51-5.25c0-5.46 4.45-9.91 9.9-9.91 2.65 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.9 7c0 5.46-4.45 9.91-9.6 9.91zm5.43-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.5-.17 0-.37-.02-.57-.02s-.52.07-.8.37c-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"></path>
        </svg>
      </a>
      <a href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a href={contact.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"></path>
        </svg>
      </a>
      <a href={contact.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M16.5 2h-3.1v13.5a3.28 3.28 0 1 1-2.93-3.26v-3.11C7.13 9.34 4.5 12.1 4.5 15.5 4.5 19.09 7.41 22 11 22s6.5-2.91 6.5-6.5V9.1c1.22.81 2.68 1.29 4.24 1.31V7.32c-1.35-.17-2.53-.72-3.43-1.62-.9-.9-1.44-2.08-1.61-3.43z"></path>
        </svg>
      </a>
      <a href={contact.phoneHref} aria-label="Llamar por teléfono">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
        </svg>
      </a>
    </div>

    <p class="footer__copyright">© {new Date().getFullYear()} TATUX 3D - Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 88px;
  }

  .footer__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .footer__eyebrow {
    color: var(--color-blue-electric);
  }

  .footer__title {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: var(--color-blue-deep);
  }

  .footer__subtitle {
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .footer__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .footer__contact {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 32px;
  }

  .footer__contact li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .footer__contact-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer__contact a {
    color: var(--color-blue-deep);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__contact a:hover {
    color: var(--color-blue-electric);
  }

  .footer__copyright {
    margin-top: 24px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .footer__social {
    display: flex;
    gap: 16px;
    margin-top: 16px;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(3, 42, 242, 0.08);
    color: var(--color-blue-electric);
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .footer__social a:hover {
    background: rgba(3, 42, 242, 0.16);
    transform: translateY(-2px);
  }
</style>
