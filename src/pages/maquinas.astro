---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingModal from "../components/BookingModal.astro";
import BookingFormCard from "../components/BookingFormCard.astro";
import WhatsAppFloatingButton from "../components/WhatsAppFloatingButton.astro";
import MachineCards from "../components/MachineCards.astro";
import { siteConfig } from "../data/site";

const { machines } = siteConfig;
---

<Layout
  title="Máquinas | TATUX 3D"
  description="Impresoras 3D con capacitación y soporte de TATUX 3D, la granja de impresión 3D que produce con ellas todos los días."
>
  <Header />

  <main>
    <section class="section machines-hero aura-blue-mint">
      <div class="container machines-hero__inner">
        <p class="eyebrow machines-hero__eyebrow">Venta de máquinas</p>
        <h1 class="machines-hero__title">Impresoras 3D para tu propia producción</h1>
        <p class="machines-hero__text">{machines.teaserText}</p>
        <a href="#consulta" class="btn btn-solid">Consultar por una máquina</a>
      </div>
    </section>

    <section class="section machines-list">
      <div class="container">
        <h2 class="machines-list__title">Modelos</h2>

        <MachineCards />
      </div>
    </section>

    <section class="section machines-support aura-mint">
      <div class="container machines-support__grid">
        <div class="card-soft machines-support__card">
          <h2 class="machines-support__title">Capacitación</h2>
          <p>{machines.training}</p>
        </div>
        <div class="card-soft machines-support__card">
          <h2 class="machines-support__title">Soporte</h2>
          <p>{machines.support}</p>
        </div>
      </div>
    </section>

    <section id="consulta" class="section machines-form">
      <div class="container machines-form__inner">
        <BookingFormCard
          formId="machines-form"
          heading="Consultá por una máquina"
          origin="Máquinas"
          afterSubmit="message"
          submitLabel="Enviar consulta"
        />
      </div>
    </section>
  </main>

  <Footer />
  <BookingModal autoOpen={false} />
  <WhatsAppFloatingButton />
</Layout>

<style>
  .machines-hero__inner {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .machines-hero__eyebrow {
    color: var(--color-blue-electric);
  }

  .machines-hero__title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    color: var(--color-blue-deep);
    line-height: 1.15;
  }

  .machines-hero__text {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 8px;
  }

  .machines-list__title,
  .machines-support__title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--color-blue-deep);
  }

  .machines-list__title {
    text-align: center;
    margin-bottom: 32px;
  }

  .machines-support__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 760px) {
    .machines-support__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .machines-support__card {
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--color-text-muted);
  }

  .machines-form__inner {
    max-width: 560px;
    margin-inline: auto;
  }
</style>
